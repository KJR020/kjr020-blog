---
import Kuri from "@/components/Kuri.astro";
import PostListItem from "@/components/PostListItem.astro";
import { ScrapboxCardList } from "@/components/scrapbox";
import type { ScrapboxPageData } from "@/components/scrapbox/types";
import TagList from "@/components/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate } from "@/lib/postDate";
import { HOME_DESCRIPTION_LINES } from "@/lib/siteCopy";
import type { PostSummary } from "./types";

interface Props {
  posts: PostSummary[];
  scrapboxPages?: ScrapboxPageData[];
}

const LATEST_POST_COUNT = 6;

const { posts, scrapboxPages } = Astro.props;
const [featuredPost, ...recentPosts] = posts.slice(0, LATEST_POST_COUNT);
const [homeDescriptionLead, homeDescriptionDetail] = HOME_DESCRIPTION_LINES;
---

<BaseLayout title="KJR020's Blog" description="KJR020の技術ブログ">
  <section class="home-hero shell" aria-labelledby="home-title">
    <h1 id="home-title" class="home-hero__wordmark type-display">
      <span class="home-hero__line"><span class="animate-rise-in">KJR020's</span></span>
      <span class="home-hero__line"><span class="animate-rise-in" style="animation-delay: 80ms">Blog</span></span>
    </h1>

    <div class="home-hero__base">
      <div class="home-hero__kuri">
        <Kuri size="clamp(4.5rem, 3rem + 4vw, 7rem)" />
      </div>
      <div class="home-hero__intro animate-fade-in-up" style="animation-delay: 200ms">
        <p class="home-hero__copy">
          {homeDescriptionLead}<br />
          {homeDescriptionDetail}
        </p>
      </div>
    </div>
  </section>

  <div class="home-content shell grid-16">
    <section id="latest-posts" class="home-main" aria-labelledby="latest-posts-title">
      <div class="home-section-head">
        <div class="section-heading">
          <h2 id="latest-posts-title" class="section-heading__title">Posts</h2>
          <p class="section-heading__sub">新しい記事</p>
        </div>
        {
          posts.length > LATEST_POST_COUNT && (
            <a href="/posts" class="arrow-link">
              すべての記事
              <svg
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </a>
          )
        }
      </div>

      {
        featuredPost && (
          <article class="feature">
            <p class="feature__meta type-meta">
              <span class="feature__badge">Latest</span>
              <time datetime={featuredPost.data.date.toISOString()}>
                {formatPostDate(featuredPost.data.date)}
              </time>
            </p>
            <h3 class="feature__title type-heading">
              <a
                href={`/posts/${featuredPost.id}`}
                class="feature__link"
              >
                <span class="feature__title-text">{featuredPost.data.title}</span>
              </a>
            </h3>
            {featuredPost.excerpt && <p class="feature__excerpt">{featuredPost.excerpt}</p>}
            <TagList tags={featuredPost.data.tags ?? []} size="md" />
          </article>
        )
      }

      {
        recentPosts.length > 0 && (
          <div class="home-list">
            {recentPosts.map((post) => (
              <PostListItem post={post} />
            ))}
          </div>
        )
      }
    </section>

    <aside id="scrapbox" class="home-aside" aria-labelledby="notes-title">
      <div class="home-section-head">
        <div class="section-heading">
          <h2 id="notes-title" class="section-heading__title">Notes</h2>
          <p class="section-heading__sub">Cosenseのメモ書き</p>
        </div>
      </div>
      <ScrapboxCardList project="KJR020" pages={scrapboxPages} limit={5} client:load />
      <a
        href="https://scrapbox.io/KJR020"
        target="_blank"
        rel="noopener noreferrer"
        class="arrow-link home-aside__more"
        data-external
      >
        すべて見る
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>
    </aside>
  </div>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .home-hero {
    padding-block: clamp(2.618rem, 1rem + 5vw, 6.854rem) var(--phi-2);
  }

  .home-hero__wordmark {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    margin: 0;
    margin-inline-start: -0.04em;
    font-size: var(--text-wordmark);
    line-height: 1;
  }

  .home-hero__line {
    display: block;
    overflow: clip;
    overflow-clip-margin: 0.1em;
    padding-block-end: 0.08em;
  }

  /*
   * 狭い画面では2行に組み、2行目の「Blog」の右側をくりの立ち位置として空ける。
   * 1行に収めるより文字を大きくできる
   */
  @media (max-width: 47.999rem) {
    .home-hero__wordmark {
      font-size: min(17vw, 6.854rem);
    }

    .home-hero__line {
      flex-basis: 100%;
    }
  }

  .home-hero__base {
    position: relative;
    display: grid;
    gap: var(--phi-1);
    margin-block-start: var(--phi-2);
    padding-block-start: var(--phi-1);
    border-block-start: 1px solid var(--foreground);
  }

  @media (min-width: 48rem) {
    .home-hero__base {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }

  /* 区切り線を地面に見立て、くりの足先を線へ乗せる */
  .home-hero__kuri {
    position: absolute;
    inset-block-end: calc(100% + 1px);
    inset-inline-end: 0;
  }

  .home-hero__intro {
    display: flex;
    align-items: center;
    gap: var(--phi-0);
  }

  .home-hero__copy {
    margin: 0;
    color: var(--foreground-soft);
    font-size: clamp(0.9375rem, 0.9rem + 0.2vw, 1.0625rem);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }

  /* ---------- Sections ---------- */
  .home-content {
    row-gap: var(--section-gap);
    padding-block-start: clamp(1.618rem, 0.5rem + 4vw, 4.236rem);
  }

  .home-main {
    grid-column: 1 / span 11;
    min-inline-size: 0;
  }

  .home-aside {
    grid-column: 13 / span 4;
    min-inline-size: 0;
  }

  @media (max-width: 63.999rem) {
    .home-aside {
      margin-block-start: var(--section-gap);
    }
  }

  /* メモが0件のときは、見出しと枠だけ残さず領域ごと畳む */
  .home-aside:has([data-notes-empty]) {
    display: none;
  }

  .home-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--phi-neg1) var(--phi-1);
    margin-block-end: var(--phi-1);
  }

  /* 主領域と補助領域で見出しの高さを揃え、下の罫線を同じ高さに引く */
  .home-section-head .section-heading {
    flex-direction: column;
    align-items: flex-start;
  }

  .home-section-head {
    align-items: flex-end;
  }

  .home-aside__more {
    margin-block-start: var(--phi-1);
  }

  /* ---------- Featured post ---------- */
  .feature {
    position: relative;
    display: grid;
    gap: var(--phi-0);
    padding-block: var(--phi-2);
    border-block-start: 1px solid var(--foreground);
  }

  .feature__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--phi-neg1);
    margin: 0;
  }

  .feature__meta > :not(:first-child)::before {
    margin-inline-end: var(--phi-neg1);
    color: var(--border-strong);
    content: "/";
  }

  /* 面で囲まず、墨の文字だけで示す。日付と同じ行に並ぶ索引の見出しとして扱う */
  .feature__badge {
    color: var(--foreground);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .feature__title {
    margin: 0;
    font-size: var(--text-feature-title);
    line-height: var(--lh-tight);
  }

  .feature__link {
    color: var(--foreground);
    text-decoration: none;
  }

  .feature__link::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .feature__link:focus-visible {
    outline: none;
  }

  .feature__link:focus-visible::after {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: var(--radius);
  }

  .feature__title-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 2px;
    transition:
      background-size var(--duration-base) var(--ease-move),
      color var(--duration-fast) var(--ease-move);
  }

  .feature:not(:has(.tag-list:hover)):hover .feature__title-text,
  .feature__link:focus-visible .feature__title-text {
    background-size: 100% 2px;
    color: var(--link);
  }

  .feature__excerpt {
    display: -webkit-box;
    max-inline-size: 40rem;
    margin: 0;
    overflow: hidden;
    color: var(--muted-foreground);
    line-height: 1.85;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature__title-text {
      transition-duration: 0s;
    }
  }
</style>
