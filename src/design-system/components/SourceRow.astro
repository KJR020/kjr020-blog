---
interface Props {
  label?: "Source" | "Specification";
  /** リポジトリ内のパス。mainブランチの最新ファイルへリンクする */
  files: readonly string[];
  /** 外部パッケージ名。リポジトリにないためリンクしない */
  packages?: readonly string[];
}

const { label = "Source", files, packages = [] } = Astro.props;

const REPOSITORY_BLOB_URL = "https://github.com/KJR020/kjr020-blog/blob/main";

const toFileUrl = (path: string) => `${REPOSITORY_BLOB_URL}/${encodeURI(path)}`;
---

<p class="source-row">
  <strong>{label}</strong>
  {files.map((path) => (
    <a href={toFileUrl(path)} target="_blank" rel="noopener noreferrer">
      <code>{path}</code>
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="10"
        height="10"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </svg>
    </a>
  ))}
  {packages.map((name) => <code>{name}</code>)}
</p>
