{
  "name": "kjr020-blog",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Personal blog built with Astro",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/prepare-public-build.ts",
    "build": "astro build",
    "build:test": "TEST_FIXTURES=true LINK_CARD_FETCH_MODE=offline pnpm build",
    "generate:og-image": "tsx scripts/generate-og-image.ts",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check src/ tests/",
    "lint:fix": "biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "format:check": "biome format src/ tests/",
    "check:links": "lychee --config lychee.toml README.md 'docs/**/*.md'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.functions.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:report": "vitest run --coverage --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.statements=0 --coverage.thresholds.branches=0",
    "test:coverage:check": "vitest run --coverage",
    "test:e2e": "docker compose -f compose.playwright.yml run --build --rm e2e",
    "test:design-system": "playwright test --config playwright.design-system.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose -f compose.playwright.yml run --build --rm update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/KJR020/kjr020-blog.git"
  },
  "keywords": [],
  "author": "KJR020",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/KJR020/kjr020-blog/issues"
  },
  "homepage": "https://kjr020.dev/",
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@beoe/rehype-mermaid": "^0.4.2",
    "@giscus/react": "^3.1.0",
    "@r4ai/remark-callout": "^0.6.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.18",
    "astro": "^7.0.7",
    "astro-pagefind": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark-link-card": "^1.3.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.17",
    "jsdom": "^27.4.0",
    "playwright": "1.57.0",
    "satori": "^0.33.4",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17",
    "wrangler": "^4.79.0"
  }
}
