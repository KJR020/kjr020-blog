---
import ContentCatalog from "../components/catalog/ContentCatalog.astro";
import FoundationsCatalog from "../components/catalog/FoundationsCatalog.astro";
import DesignSystemLayout from "../components/DesignSystemLayout.astro";
---

<DesignSystemLayout
  activePage="patterns"
  title="パターン - KJR020's Blog デザインシステム"
  description="KJR020's Blogの状態、記事コンテンツ、ページ構造を一貫して組み立てるための仕様"
>
  <header class="book-intro" id="overview">
    <h1 class="book-title">パターン</h1>
    <p class="book-lead">パターンは、ページや画面幅が変わっても、読者が記事を探し、読み、別のページへ移動できるようにするための部品の組み合わせ方である。</p>
    <p class="book-lead">パターンは、次の3つで構成する。</p>
    <ul class="book-lead-list">
      <li><strong>状態の体系</strong>: 操作中、取得中、現在地、選択の伝え方</li>
      <li><strong>記事コンテンツ</strong>: Markdownで書いた本文と補足の表示</li>
      <li><strong>ページの型</strong>: ページの種類ごとの情報の順序と主要な操作</li>
    </ul>
  </header>

  <FoundationsCatalog sections={["states"]} />
  <ContentCatalog />
</DesignSystemLayout>
