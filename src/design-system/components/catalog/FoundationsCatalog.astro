---
import Kuri from "@/components/Kuri.astro";

const colorTokens = [
  { name: "--background", label: "Background / Card", role: "ページと面" },
  { name: "--foreground", label: "Foreground", role: "本文と主要情報" },
  { name: "--primary", label: "Primary", role: "主要操作" },
  { name: "--link", label: "Link", role: "遷移可能な情報" },
  { name: "--secondary", label: "Secondary / Muted", role: "補助操作と弱い面" },
  { name: "--muted-foreground", label: "Muted foreground", role: "補助情報" },
  { name: "--border", label: "Border / Input", role: "領域の境界" },
  { name: "--destructive", label: "Destructive", role: "破壊的な操作とエラー" },
] as const;

const calloutTokens = [
  ["--callout-note", "Note", "追加の背景情報や参照"],
  ["--callout-tip", "Tip", "実装を進めるためのヒント"],
  ["--callout-warning", "Warning", "注意が必要な条件"],
  ["--callout-danger", "Danger", "破壊的・危険な操作"],
] as const;

const typeScale = [
  ["Display", "--font-size-display", "700", "404など単一状態の強調"],
  ["Title 1", "--font-size-title1", "700", "ページタイトル・記事タイトル"],
  ["Title 2", "--font-size-title2", "700", "セクション見出し"],
  ["Title 3", "--font-size-title3", "500", "小見出し"],
  ["Body", "--font-size-body", "400", "本文"],
  ["Small", "--font-size-small", "400", "補助テキスト・メタ情報"],
  ["Caption", "--font-size-caption", "400", "短い補足"],
] as const;

const spacingTokens = [
  ["φ⁻³", "--phi-neg3"],
  ["φ⁻²", "--phi-neg2"],
  ["φ⁻¹", "--phi-neg1"],
  ["φ⁰", "--phi-0"],
  ["φ¹", "--phi-1"],
  ["φ²", "--phi-2"],
  ["φ³", "--phi-3"],
  ["φ⁴", "--phi-4"],
] as const;

/** UIの動き。用途の短い順に並べる */
const uiCurves = [
  ["--ease-enter", "--duration-slow", "Enter", "内容の入場。減速して止まる"],
  ["--ease-exit", "--duration-fast", "Exit", "退場。加速して短く消える"],
  ["--ease-move", "--duration-base", "Move", "位置の移動、下線"],
  ["--ease-emphasis", "--duration-hero", "Emphasis", "ヒーローの見出しなど、表現的な入場"],
  ["--ease-in-out", "--duration-base", "In-out", "往復する動き、まばたき以外の目の動き"],
] as const;

/** くりのモーション。重さ・接地・間を表す */
const characterCurves = [
  ["--ease-anticipate", "--duration-kuri-jump", "Anticipate", "ジャンプ前に沈む"],
  ["--ease-push", "--duration-kuri-jump", "Push", "押し出し。離陸の速度を空中の初速へつなぐ"],
  ["--ease-fall", "--duration-kuri-jump", "Fall", "落下。加速したまま接地する"],
  ["--ease-impact", "--duration-kuri-jump", "Impact", "着地の反動。すぐに止まる"],
  ["--ease-settle", "--duration-kuri-jump", "Settle", "反動から静止へ。呼吸の吸う・吐く"],
  ["--ease-blink-close", "--duration-blink-close", "Blink close", "まぶたは速く閉じる"],
  ["--ease-blink-open", "--duration-blink-open", "Blink open", "まぶたはゆっくり開く"],
] as const;

const durationTokens = [
  ["--duration-quick", "ポインターへの即時反応"],
  ["--duration-fast", "Hover、矢印"],
  ["--duration-base", "下線、部品の状態変化"],
  ["--duration-slow", "内容の入場"],
  ["--duration-hero", "ヒーローの見出し、伸び"],
  ["--duration-blink-close", "まばたき: 閉じる"],
  ["--duration-blink-hold", "まばたき: 閉じたまま"],
  ["--duration-blink-open", "まばたき: 開く"],
  ["--duration-kuri-wake", "起きる"],
  ["--duration-kuri-enter", "罫線の下からの登場"],
  ["--duration-kuri-jump", "ジャンプ"],
  ["--duration-kuri-doze", "うとうとして眠る"],
  ["--duration-kuri-breathe", "呼吸の1周期"],
] as const;

type FoundationSection = "tokens" | "layout" | "states";

interface Props {
  sections?: readonly FoundationSection[];
}

const { sections = ["tokens", "layout", "states"] } = Astro.props;
const shows = (section: FoundationSection) => sections.includes(section);
---

{shows("tokens") && (
<section class="spec" id="tokens">
  <h2>1. トークン</h2>
  <p class="src">色、文字、余白、角丸、影などの値に用途を表す名前を付け、ページと部品で共有します。値の直接指定を減らし、変更時にブログ全体の意味と見た目を同じ基準で更新できるようにします。</p>

  <div class="spec-item" id="color">
    <h3>1-1. 色の役割</h3>
    <p class="src">色は情報の役割、操作可能性、状態を伝えるために使います。Light / Darkで同じ意味を保つsemantic tokenを選び、色だけを唯一の手がかりにしません。ニュートラルを面と文字、青を遷移、赤を破壊的状態、4色を記事内Calloutに限定します。</p>
    <div class="demo swatches">
      {colorTokens.map((token) => (
        <div class="swatch" data-token={token.name}>
          <div class="swatch-color" style={`--swatch: var(${token.name})`}></div>
          <strong>{token.label}</strong>
          <code data-token-value={token.name}>var({token.name})</code>
          <span>{token.role}</span>
        </div>
      ))}
    </div>
    <p class="source-row"><strong>Source</strong><code>src/styles/globals.css</code></p>
  </div>

  <div class="spec-item" id="callout-colors">
    <h3>1-2. 記事コールアウト色</h3>
    <p class="src">Callout色は、本文から補足の種類を識別するためだけに使います。面全体を塗らず、左2pxの境界とタイトル文字へ適用します。色が分からなくても見出しから意味を判断できるようにします。</p>
    <div class="demo swatches">
      {calloutTokens.map(([token, label, role]) => (
        <div class="swatch" data-token={token}>
          <div class="swatch-color" style={`--swatch: var(${token})`}></div>
          <strong>{label}</strong>
          <code data-token-value={token}>var({token})</code>
          <span>{role}</span>
        </div>
      ))}
    </div>
    <p class="source-row"><strong>Source</strong><code>src/styles/globals.css</code></p>
  </div>

  <div class="spec-item" id="typography">
    <h3>1-3. 文字階層</h3>
    <p class="src">書体、サイズ、ウェイト、行高で、ページ内の情報階層と読み方を伝えます。Headerはsystem sans、本文と見出しはNoto Sans JP、コードとトークン名はJetBrains Monoを使います。役割ごとのサイズと行高は黄金比φを基準に定義します。</p>
    <div class="demo type-list">
      {typeScale.map(([label, token, weight, usage]) => (
        <div class="type-row">
          <div style={`font-size: var(${token}); font-weight: ${weight}`}>読みやすさから設計する</div>
          <dl>
            <div><dt>{label}</dt><dd><code>{token}</code></dd></div>
            <div><dt>用途</dt><dd>{usage}</dd></div>
          </dl>
        </div>
      ))}
    </div>
    <p class="source-row"><strong>Source</strong><code>src/styles/globals.css</code><code>src/layouts/BaseHead.astro</code></p>
  </div>

  <div class="spec-item" id="spacing">
    <h3>1-4. 黄金比スペーシング</h3>
    <p class="src">余白は、要素どうしの関係と情報の区切りを伝えるために使います。黄金比φのscaleから選び、同一要素内、部品間、セクション間、ページ外周の順に広げます。局所的な数値を追加する前に、既存tokenで関係を表せるか確認します。</p>
    <div class="demo spacing-list">
      {spacingTokens.map(([label, token]) => (
        <div class="spacing-row">
          <code>{label}</code>
          <span class="spacing-bar" style={`--space: var(${token})`}></span>
          <code>{token}</code>
          <span data-token-value={token}>var({token})</span>
        </div>
      ))}
    </div>
    <p class="source-row"><strong>Source</strong><code>src/styles/globals.css</code></p>
  </div>

  <div class="spec-item" id="radius">
    <h3>1-5. 角丸・影</h3>
    <p class="src">角丸は同じ面に属する情報のまとまりを伝えます。基準角丸は0.618remとし、装飾だけを目的に丸めません。面の区切りは罫線と余白で示し、影はDialog・Popover・Menuなど、本文の前面に重なる面にだけ使います。</p>
    <div class="demo foundation-pair">
      <div class="radius-grid">
        <div><span class="radius-sample radius-sm"></span><strong>Small</strong><code>--radius-sm</code></div>
        <div><span class="radius-sample radius-md"></span><strong>Medium</strong><code>--radius-md</code></div>
        <div><span class="radius-sample radius-lg"></span><strong>Large</strong><code>--radius-lg</code></div>
        <div><span class="radius-sample radius-full"></span><strong>Full</strong><code>9999px</code></div>
      </div>
      <div class="shadow-specimen">
        <span aria-hidden="true"></span>
        <div><strong>Overlay shadow</strong><code>--shadow-overlay</code><small>Dialog・Popover・Menuなど、本文の前面に浮く面</small></div>
      </div>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/styles/globals.css</code><code>src/design-system/styles.css</code></p>
  </div>

  <div class="spec-item" id="motion">
    <h3>1-6. モーション</h3>
    <p class="src">UIの動きは短く規則的に、表現的な動きはヒーローとくりに限る。カーブとdurationは<code>globals.css</code>のトークンを正本とし、くりのスクリプトも同じトークンを実行時に読み込む。各カーブは現在のトークン値から描画し、再生で同じ値の動きを確認できる。</p>

    <h4 class="motion-heading">UIのイージング</h4>
    <div class="demo curve-grid">
      {uiCurves.map(([easing, duration, label, usage]) => (
        <figure class="curve-card" data-easing={easing} data-duration={duration}>
          <svg class="curve-plot" viewBox="-12 -32 124 164" aria-hidden="true">
            <rect class="curve-frame" x="0" y="0" width="100" height="100" />
            <line class="curve-guide" x1="0" y1="100" x2="100" y2="0" />
            <line class="curve-handle" data-handle="1" />
            <line class="curve-handle" data-handle="2" />
            <path class="curve-line" />
          </svg>
          <figcaption>
            <strong>{label}</strong>
            <code>{easing}</code>
            <code class="curve-value"></code>
            <small>{usage}</small>
          </figcaption>
          <div class="curve-track"><span class="curve-dot" aria-hidden="true"></span></div>
          <button type="button" class="curve-play">{label}を再生</button>
        </figure>
      ))}
    </div>

    <h4 class="motion-heading">くりのイージング</h4>
    <div class="demo curve-grid">
      {characterCurves.map(([easing, duration, label, usage]) => (
        <figure class="curve-card" data-easing={easing} data-duration={duration}>
          <svg class="curve-plot" viewBox="-12 -32 124 164" aria-hidden="true">
            <rect class="curve-frame" x="0" y="0" width="100" height="100" />
            <line class="curve-guide" x1="0" y1="100" x2="100" y2="0" />
            <line class="curve-handle" data-handle="1" />
            <line class="curve-handle" data-handle="2" />
            <path class="curve-line" />
          </svg>
          <figcaption>
            <strong>{label}</strong>
            <code>{easing}</code>
            <code class="curve-value"></code>
            <small>{usage}</small>
          </figcaption>
          <div class="curve-track"><span class="curve-dot" aria-hidden="true"></span></div>
          <button type="button" class="curve-play">{label}を再生</button>
        </figure>
      ))}
    </div>

    <h4 class="motion-heading">Duration</h4>
    <div class="demo duration-list">
      {durationTokens.map(([token, usage]) => (
        <div class="duration-row" data-duration={token}>
          <code>{token}</code>
          <span class="duration-bar" aria-hidden="true"></span>
          <span class="duration-value"></span>
          <small>{usage}</small>
        </div>
      ))}
    </div>

    <h4 class="motion-heading">くりのモーション</h4>
    <div class="demo kuri-stage">
      <div class="kuri-stage__ground"><Kuri size="7rem" /></div>
      <div class="kuri-stage__controls">
        <button type="button" data-kuri-event="kuri:enter">登場</button>
        <button type="button" data-kuri-event="kuri:jump">ジャンプ</button>
        <button type="button" data-kuri-event="kuri:blink">まばたき</button>
        <button type="button" data-kuri-event="kuri:sleep">眠る</button>
        <button type="button" data-kuri-event="kuri:wake">起きる</button>
      </div>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/styles/globals.css</code><code>src/components/Kuri.astro</code></p>
  </div>
</section>
)}

{shows("layout") && (
<section class="spec" id="layout">
  <h2>2. レイアウト原則</h2>
  <p class="src">
    ページ全体の幅、列、余白、読む順序を定義します。コンテンツの種類と画面幅に応じて配置を変えても、情報の優先順位とDOM順を保つための基準です。
  </p>

  <div class="spec-item" id="page-shell">
    <h3>2-1. ページシェル</h3>
    <p class="src">全ページはSticky Header → Main → Footerで構成する。Mainの栗マスコットは本文操作を妨げない背景要素として扱う。</p>
    <div class="demo layout-stack">
      <div class="layout-bar"><strong>Sticky Header</strong><span>border-bottom · backdrop blur</span></div>
      <div class="layout-bar layout-main"><strong>Main</strong><span>flex: 1 · Kuri watermark</span></div>
      <div class="layout-bar"><strong>Footer</strong><span>border-top · privacy / social links</span></div>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/layouts/BaseLayout.astro</code></p>
  </div>

  <div class="spec-item" id="grid">
    <h3>2-2. 16列グリッド</h3>
    <p class="src">Wideではシェルの内容幅を16列とgutter 16pxへ分割し、主要領域の幅と位置を列で決める。列は配置を揃えるための座標系で、CSS Gridの使用そのものは要件にしない。部品内部はspacing tokenで配置する。</p>
    <div class="demo">
      <div class="shell-anatomy" aria-label="シェルと内部配置の見本">
        <span class="shell-margin">16px</span>
        <div class="shell-inner">
          <div class="shell-container">主領域 1〜12列（1120pxのとき836px）</div>
          <div class="shell-part">
            <strong>補助領域 13〜16列</strong>
            <span>1120pxのとき268px。補助情報がなければ余白として残す</span>
          </div>
        </div>
        <span class="shell-margin">16px</span>
      </div>
    </div>
    <p class="source-row"><strong>Specification</strong><code>docs/design/grid-system.md</code></p>
  </div>

  <div class="spec-item" id="grid-breakpoints">
    <h3>2-3. Breakpoints</h3>
    <p class="src">Tailwindのmdとlgに合わせて3段階とする。Breakpointはviewport全体の幅で判定する。</p>
    <div class="demo table-scroll">
      <table class="map">
        <thead><tr><th>Mode</th><th>Viewport</th><th>Tailwind</th><th>左右余白</th><th>主要領域</th></tr></thead>
        <tbody>
          <tr><td>Compact</td><td>767px以下</td><td>既定</td><td>16px</td><td>縦積み</td></tr>
          <tr><td>Medium</td><td>768px以上</td><td>md</td><td>16px</td><td>縦積み</td></tr>
          <tr><td>Wide</td><td>1024px以上</td><td>lg</td><td>16px</td><td>主領域＋補助領域</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="spec-item" id="grid-types">
    <h3>2-4. ページ別の最大幅</h3>
    <p class="src">最大幅はページごとに定める。16列へ分割するのはシェルの内容幅。</p>
    <div class="demo table-scroll">
      <table class="map">
        <thead><tr><th>ページ</th><th>最大幅</th><th>指定</th></tr></thead>
        <tbody>
          <tr><td>記事詳細</td><td>1152px / 72rem</td><td>max-w-6xl</td></tr>
          <tr><td>ホーム</td><td>1152px / 72rem</td><td>max-w-6xl</td></tr>
          <tr><td>Privacy Policy</td><td>768px / 48rem</td><td>max-w-3xl</td></tr>
          <tr><td>記事一覧、タグ別一覧、検索</td><td>Breakpoint連動</td><td>container</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="spec-item" id="grid-composition">
    <h3>2-5. 配置パターン</h3>
    <p class="src">Wideでは主領域を1〜12列、補助領域を13〜16列へ置く。Medium以下はDOM順を保ったまま全幅で縦積みし、記事詳細の目次は折りたたみ表示へ切り替える。</p>
    <div class="demo grid-composition">
      <div class="grid-region grid-region-header"><strong>記事ヘッダー</strong><span>タイトル 1〜12列 / マスコット 14〜16列</span></div>
      <div class="grid-region grid-region-main"><strong>本文 / 記事一覧</strong><span>Wide: 1〜12列</span></div>
      <div class="grid-region grid-region-aside"><strong>目次 / メモ</strong><span>Wide: 13〜16列</span></div>
    </div>
  </div>

  <div class="spec-item" id="width-tokens">
    <h3>2-6. 幅トークン</h3>
    <p class="src">最大幅はTailwindのユーティリティで指定する。ページごとの採用値は<code>docs/design/grid-system.md</code>を参照する。</p>
    <div class="demo layout-stack width-stack">
      <div class="layout-bar width-wide"><strong>max-w-6xl</strong><span>1152px · 記事詳細</span></div>
      <div class="layout-bar width-narrow"><strong>max-w-3xl</strong><span>768px · Privacy Policy</span></div>
      <div class="layout-bar width-overlay"><strong>max-w-lg</strong><span>512px · Command Palette</span></div>
    </div>
  </div>

  <div class="spec-item" id="spacing-hierarchy">
    <h3>2-7. 余白の階層</h3>
    <p class="src">情報の関係が強いほど狭く、セクションやページの境界ほど広い余白を使う。</p>
    <div class="demo table-scroll">
      <table class="map">
        <thead><tr><th>関係</th><th>主な値</th><th>実装例</th></tr></thead>
        <tbody>
          <tr><td>同一要素内</td><td>φ⁻³〜φ⁻¹</td><td>ナビ間隔、タイトルと補足、カード行間</td></tr>
          <tr><td>関連要素間</td><td>φ⁰〜φ¹</td><td>カードpadding、見出しと一覧</td></tr>
          <tr><td>セクション間</td><td>φ¹〜φ²</td><td>Posts / Notes、記事header</td></tr>
          <tr><td>ページ外周</td><td>px-4 + py-φ²</td><td>一覧・記事詳細・ヒーロー</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="spec-item" id="emphasis-hierarchy">
    <h3>2-8. 見出しと強調の階層</h3>
    <p class="src">ページタイトル → セクション見出し → カードタイトル → メタ情報の順に、サイズ・太さ・色を弱める。</p>
    <div class="demo emphasis-demo">
      <div class="emphasis-level emphasis-page"><strong>Page title</strong><span>title1 / bold / tracking-tight</span></div>
      <div class="emphasis-level emphasis-section"><strong>Section heading</strong><span>title3 / 左にlink色2px線</span></div>
      <div class="emphasis-level"><strong>Item title</strong><span>body / semibold / hoverでlink色</span></div>
      <div class="emphasis-level"><strong>Metadata</strong><span>small / muted foreground</span></div>
    </div>
  </div>
</section>
)}

{shows("states") && (
<section class="spec" id="states">
  <h2>3. 状態の体系</h2>
  <p class="src">操作中、非同期データ、現在位置と選択を、部品が変わっても同じ意味で伝えるための規則です。見た目だけでなく、文言とARIAを組み合わせて状態を識別できるようにします。</p>

  <div class="spec-item" id="interaction-states">
    <h3>3-1. 操作状態</h3>
    <p class="src">色の反転だけに頼らず、背景・文字色・ring・opacityの組み合わせで表す。</p>
    <div class="demo state-grid">
      <div class="interactive-state">Default<span>surface + border</span></div>
      <div class="interactive-state state-hover">Hover<span>accent background</span></div>
      <div class="interactive-state state-focus">Focus visible<span>visible ring</span></div>
      <div class="interactive-state state-disabled">Disabled<span>opacity 50%</span></div>
      <div class="interactive-state state-invalid">Invalid<span>destructive border / ring</span></div>
    </div>
  </div>

  <div class="spec-item" id="async-states">
    <h3>3-2. 非同期データの4状態</h3>
    <p class="src">非同期コンテンツは、ローディング・表示済み・空・エラーを区別する。回復可能なエラーには再読み込みを用意する。</p>
    <div class="demo state-grid async-grid">
      <div class="async-state"><span class="spinner" aria-hidden="true"></span><strong>読み込んでいます…</strong></div>
      <div class="async-state"><span aria-hidden="true">✓</span><strong>コンテンツを表示</strong></div>
      <div class="async-state"><span aria-hidden="true">◇</span><strong>ページがありません</strong></div>
      <div class="async-state"><span aria-hidden="true">!</span><strong>読み込めませんでした</strong><small>再読み込み</small></div>
    </div>
  </div>

  <div class="spec-item" id="selection-states">
    <h3>3-3. 現在地と選択</h3>
    <p class="src">Headerとサイドバーの現在ページはlink色＋semibold。見出しのアクセントラインは現在地表示へ転用しない。目次は現在見出しをforeground＋medium。Command Paletteは選択行をaccent面で示す。</p>
    <div class="demo selection-demo">
      <a href="#selection-states" aria-current="page">Page navigation current</a>
      <a href="#selection-states" aria-current="location">TOC current</a>
      <div role="option" aria-selected="true">Command Palette selected</div>
    </div>
  </div>
</section>
)}

<script>
  // カーブとdurationは、現在のトークン値から描画する。値を標本側へ複製しない
  const root = getComputedStyle(document.documentElement);
  const read = (name: string) => root.getPropertyValue(name).trim();
  const toMs = (value: string) =>
    value.endsWith("ms") ? Number.parseFloat(value) : Number.parseFloat(value) * 1000;

  for (const card of document.querySelectorAll<HTMLElement>(".curve-card")) {
    const easing = read(card.dataset.easing ?? "");
    const duration = toMs(read(card.dataset.duration ?? ""));
    const match = /cubic-bezier\(([^)]+)\)/.exec(easing);
    const valueLabel = card.querySelector(".curve-value");
    if (valueLabel) valueLabel.textContent = `${easing} / ${duration}ms`;
    if (match) {
      const [x1, y1, x2, y2] = match[1].split(",").map(Number);
      const px = (x: number) => x * 100;
      const py = (y: number) => 100 - y * 100;
      card
        .querySelector(".curve-line")
        ?.setAttribute("d", `M0 100C${px(x1)} ${py(y1)} ${px(x2)} ${py(y2)} 100 0`);
      const handles = card.querySelectorAll(".curve-handle");
      const set = (line: Element | undefined, a: number[], b: number[]) => {
        line?.setAttribute("x1", String(a[0]));
        line?.setAttribute("y1", String(a[1]));
        line?.setAttribute("x2", String(b[0]));
        line?.setAttribute("y2", String(b[1]));
      };
      set(handles[0], [0, 100], [px(x1), py(y1)]);
      set(handles[1], [100, 0], [px(x2), py(y2)]);
    }
    card.querySelector(".curve-play")?.addEventListener("click", () => {
      const track = card.querySelector<HTMLElement>(".curve-track");
      const dot = card.querySelector<HTMLElement>(".curve-dot");
      if (!track || !dot) return;
      const distance = track.clientWidth - dot.offsetWidth;
      dot.animate([{ transform: "translateX(0)" }, { transform: `translateX(${distance}px)` }], {
        duration,
        easing,
        fill: "forwards",
      });
    });
  }

  const durations = [...document.querySelectorAll<HTMLElement>(".duration-row")];
  const values = durations.map((row) => toMs(read(row.dataset.duration ?? "")));
  const longest = Math.max(...values.filter((value) => value < 3000));
  durations.forEach((row, index) => {
    const value = values[index];
    row.querySelector(".duration-value")!.textContent = value >= 1000 ? `${value / 1000}s` : `${value}ms`;
    row.style.setProperty("--duration-ratio", String(Math.min(1, value / longest)));
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-kuri-event]")) {
    button.addEventListener("click", () => {
      const kuri = button.closest(".kuri-stage")?.querySelector("[data-kuri]");
      kuri?.dispatchEvent(new Event(button.dataset.kuriEvent ?? ""));
    });
  }
</script>
