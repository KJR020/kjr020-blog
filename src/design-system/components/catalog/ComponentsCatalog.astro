---
import { getCollection } from "astro:content";
import Kuri from "@/components/Kuri.astro";
import PageHero from "@/components/PageHero.astro";
import PostListItem from "@/components/PostListItem.astro";
import { ScrapboxCardList } from "@/components/scrapbox";
import { CommandPalette } from "@/components/search/CommandPalette";
import TagList from "@/components/TagList.astro";
import { ThemeToggleAnimated } from "@/components/theme/ThemeToggleAnimated";
import { TableOfContents } from "@/components/toc";
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { Input } from "@/components/ui/input";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const specimenPost = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0] ?? {
  id: "design-system-specimen",
  data: {
    title: "デザインシステムをブログと育てる",
    date: new Date("2026-07-16"),
    tags: ["Design System", "Astro"],
  },
};

const tocHeadings = [
  { id: "markdown-content", text: "Markdown本文", level: 2 as const },
  { id: "callout", text: "Callout", level: 2 as const },
  { id: "link-card", text: "Link Card", level: 3 as const },
  { id: "code-image", text: "Code Copy / Image", level: 2 as const },
];

// 公開するカタログに実在のページと架空の説明を並べないよう、予約ドメインを使った標本データにする
const scrapboxPages = [
  {
    id: "specimen-design-note",
    title: "設計メモの標本",
    imageUrl: null,
    description: "一覧での見え方を確認するための標本です。説明は2行を超えると省略します。",
    updatedAt: "2026-07-11T00:00:00.000Z",
    url: "https://example.com/cosense/specimen-design-note",
  },
  {
    id: "specimen-reading-note",
    title: "読書メモの標本",
    imageUrl: null,
    description: "タイトル、説明、更新日の順に並べます。",
    updatedAt: "2026-07-08T00:00:00.000Z",
    url: "https://example.com/cosense/specimen-reading-note",
  },
];
---

<section class="spec" id="primitives">
  <h2>4. 基本部品</h2>
  <p class="src">ボタン、バッジ、カード、入力など、複数の場所で使う最小単位のUIです。同じ用途では、同じ部品を使います。部品ごとの状態と操作も確認できます。</p>

  <div class="spec-item" id="button">
    <h3>4-1. Button</h3>
    <p class="src">操作を開始する部品です。</p>
    <ul class="src rule-list">
      <li>
        <strong>ラベル</strong>
        <ul>
          <li>押したあとに起きることを具体的に書く</li>
        </ul>
      </li>
      <li>
        <strong>variantとsize</strong>
        <ul>
          <li>用途に合うvariantとsizeを、同じButtonコンポーネントから選ぶ</li>
        </ul>
      </li>
    </ul>
    <div class="demo component-demo">
      <div class="button-row">
        <Button>記事を読む</Button>
        <Button variant="destructive">削除する</Button>
        <Button variant="outline">下書きを確認</Button>
        <Button variant="secondary">さらに表示</Button>
        <Button variant="ghost">閉じる</Button>
        <Button variant="link">記事一覧へ</Button>
      </div>
      <div class="button-row">
        <Button size="sm">Small</Button>
        <Button>Default</Button>
        <Button size="lg">Large</Button>
        <Button disabled>読み込み中…</Button>
      </div>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/ui/button.tsx</code></p>
  </div>

  <div class="spec-item" id="badge">
    <h3>4-2. Badge / Tag</h3>
    <ul class="src rule-list">
      <li>
        <strong>Badge</strong>
        <ul>
          <li>短い状態を示す</li>
        </ul>
      </li>
      <li>
        <strong>Tag</strong>
        <ul>
          <li>記事の分類と、絞り込みへのリンクを示す</li>
        </ul>
      </li>
      <li>
        <strong>使わない場面</strong>
        <ul>
          <li>主要な操作や長い説明には使わない</li>
        </ul>
      </li>
    </ul>
    <div class="demo component-demo">
      <div class="button-row">
        <Badge>Default</Badge>
        <Badge variant="secondary">Astro</Badge>
        <Badge variant="destructive">Error</Badge>
        <Badge variant="outline">Design System</Badge>
      </div>
      <section class="tag-interaction" data-specification="tag-interaction">
        <div>
          <h4>Tag interaction</h4>
          <p>記事の分類リンクは、TagListの実装をそのまま使用する。</p>
        </div>
        <div class="tag-interaction-preview">
          <TagList tags={["Astro", "Design System"]} />
        </div>
        <div class="table-scroll">
          <table class="map">
            <thead><tr><th>状態</th><th>正規仕様</th></tr></thead>
            <tbody>
              <tr><td>Rest</td><td>細い輪郭と<code>#</code>記号で、記事リンクとは別のリンクであることを示す</td></tr>
              <tr><td>Hover / Focus</td><td>輪郭と文字を墨色(<code>--foreground</code>)へ、面を<code>--secondary</code>へ変える。変化の時間は実装の<code>--duration-fast</code>を使う。Focusではフォーカスの輪郭線も表示する</td></tr>
              <tr><td>Row coordination</td><td>Tag上では親PostListItemのタイトル下線と矢印のhoverを重ねない</td></tr>
              <tr><td>Reduced motion</td><td>移動を伴う演出を持たない。色の変化だけで状態を示す</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/ui/badge.tsx</code><code>src/components/TagList.astro</code></p>
  </div>

  <div class="spec-item" id="card">
    <h3>4-3. Card</h3>
    <p class="src">関連する情報と操作を1つの単位にまとめる部品です。Card、Header、Title、Description、Content、Footerを組み合わせて構成します。</p>
    <div class="demo card-demo">
      <Card className="specimen-card">
        <CardHeader>
          <CardTitle>デザインシステム</CardTitle>
          <CardDescription>ブログと同じ部品の表示と操作を確認できます。</CardDescription>
          <CardAction><Badge variant="outline">Connected</Badge></CardAction>
        </CardHeader>
        <CardContent><p>カード内の余白は、情報どうしの関係に合わせて選びます。</p></CardContent>
        <CardFooter className="border-t"><Button variant="outline" size="sm">詳細を見る</Button></CardFooter>
      </Card>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/ui/card.tsx</code></p>
  </div>

  <div class="spec-item" id="input">
    <h3>4-4. Input / TextLink / Kbd</h3>
    <ul class="src rule-list">
      <li>
        <strong>Input</strong>
        <ul>
          <li>目的はlabelで伝える</li>
          <li>Placeholderは入力内容の補助に限る</li>
        </ul>
      </li>
      <li>
        <strong>TextLink</strong>
        <ul>
          <li>遷移を示す</li>
        </ul>
      </li>
      <li>
        <strong>Kbd</strong>
        <ul>
          <li>利用できるショートカットを示す</li>
        </ul>
      </li>
    </ul>
    <div class="demo input-grid input-grid-complete">
      <label><span>記事を検索</span><Input placeholder="キーワードを入力" /></label>
      <label><span>無効な入力</span><Input defaultValue="Astro" aria-invalid="true" readOnly /></label>
      <div class="inline-primitives">
        <a class="text-link-specimen" href="#primitives">テキストリンク</a>
        <kbd>⌘K</kbd>
      </div>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/ui/input.tsx</code><code>src/components/Header.astro</code></p>
  </div>
</section>

<section class="spec" id="navigation">
  <h2>5. ナビゲーション・検索部品</h2>
  <p class="src">サイト内の現在地、移動先、検索手段を読者へ伝える部品です。ポインター、タッチ、キーボードで、同じ移動先と操作へ到達できることを確認します。</p>

  <div class="spec-item" id="global-navigation">
    <h3>5-1. Header / Global Navigation</h3>
    <ul class="src rule-list">
      <li>
        <strong>外観</strong>
        <ul>
          <li>高さは4remとし、画面上部に追従させる</li>
          <li>背景は紙色を82%で重ね、背後をぼかす</li>
        </ul>
      </li>
      <li>
        <strong>ブランドリンク</strong>
        <ul>
          <li>著者の写真とブログ名を組み合わせる</li>
          <li>写真は32×32pxの円に細い輪郭を付ける</li>
        </ul>
      </li>
      <li>
        <strong>現在地</strong>
        <ul>
          <li>文字の下の青い点で示す</li>
        </ul>
      </li>
      <li>
        <strong>幅による切り替え</strong>
        <ul>
          <li>48rem以上では水平ナビゲーションを表示する。48rem未満ではメニューボタンを表示する</li>
          <li>水平ナビは項目を折り返さない</li>
          <li>60rem未満では、Searchの<kbd>⌘K</kbd>表示を省く</li>
        </ul>
      </li>
    </ul>
    <div class="demo site-header-demo">
      <a class="site-brand-demo" href="#global-navigation"><img src="/images/kuri_photo.png" alt="" width="500" height="500" />KJR020's Blog</a>
      <nav class="nav-demo" aria-label="ヘッダー例">
        <a class="is-active" href="#global-navigation" aria-current="page">Home</a>
        <a href="#global-navigation">Posts</a>
        <a href="#global-navigation">Design System</a>
        <button type="button">Search <kbd>⌘K</kbd></button>
        <a href="#global-navigation">Cosense</a>
      </nav>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/Header.astro</code></p>
  </div>

  <div class="spec-item" id="command-palette">
    <h3>5-2. Command Palette</h3>
    <ul class="src rule-list">
      <li>
        <strong>開き方</strong>
        <ul>
          <li>HeaderのSearchを押すか、<kbd>⌘K</kbd> / <kbd>Ctrl K</kbd>を押すと、Command Paletteを開く</li>
        </ul>
      </li>
      <li>
        <strong>操作</strong>
        <ul>
          <li>Arrow Up / Downで検索結果を選択する</li>
          <li>Enterで選択した記事へ移動する</li>
          <li>Escapeまたは背景クリックで閉じる</li>
        </ul>
      </li>
    </ul>
    <div class="demo command-demo">
      <div class="command-search"><span aria-hidden="true">⌕</span><span>記事を検索</span><kbd>Esc</kbd></div>
      <div class="command-results" role="listbox" aria-label="検索候補の例">
        <div class="command-option is-selected" role="option" aria-selected="true">Astroブログに全文検索を導入した<small>Pagefindを使った検索UIの実装</small></div>
        <div class="command-option" role="option" aria-selected="false">Astroブログにコールアウト機能を追加した<small>記事表現を拡張する</small></div>
      </div>
      <p class="demo-instruction">このページでも<kbd>⌘K</kbd> / <kbd>Ctrl K</kbd>でCommand Paletteを開けます。</p>
      <CommandPalette client:load />
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/search/CommandPalette.tsx</code></p>
  </div>

  <div class="spec-item" id="theme-mobile">
    <h3>5-3. Theme Toggle / Mobile Menu</h3>
    <ul class="src rule-list">
      <li>
        <strong>Theme Toggle</strong>
        <ul>
          <li>画面全体を覆う波とアイコンの遷移を使う</li>
        </ul>
      </li>
      <li>
        <strong>Mobile Menu</strong>
        <ul>
          <li>メニューボタンを押すと、画面右上にメニューを重ねて表示する</li>
          <li>外側クリックとEscapeで閉じる</li>
        </ul>
      </li>
    </ul>
    <div class="demo navigation-actions-demo">
      <div><span>Theme Toggle</span><ThemeToggleAnimated client:load /></div>
      <div><span>Mobile Menu</span><button type="button" aria-label="メニューを開く" aria-expanded="false">☰</button></div>
      <dl>
        <div><dt>Theme state</dt><dd>選んだテーマをlocalStorageとhtml要素のclassへ反映する</dd></div>
        <div><dt>Menu dismissal</dt><dd>Escape / 外側クリック / リンク選択</dd></div>
      </dl>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/theme/ThemeToggleAnimated.tsx</code><code>src/components/MobileMenu.tsx</code></p>
  </div>
</section>

<section class="spec" id="blog-components">
  <h2>6. ブログ固有部品</h2>
  <p class="src">記事を探す・読む・関連情報へ移動するために、KJR020's Blog固有の情報構造を持つ部品です。実データと状態を含めて再利用し、ページごとに別の見た目や挙動を作りません。</p>

  <div class="spec-item" id="page-hero">
    <h3>6-1. PageHero</h3>
    <p class="src">欧文の大見出しと日本語の説明で、ページの目的を一覧本文より先に伝えます。mascotを指定した場合は、下端の罫線上にくりを立たせます。</p>
    <div class="demo page-demo"><PageHero title="Posts" description="ブログ記事一覧です。" mascot /></div>
    <p class="source-row"><strong>Source</strong><code>src/components/PageHero.astro</code></p>
  </div>

  <div class="spec-item" id="post-card">
    <h3>6-2. PostListItem</h3>
    <p class="src">罫線で区切った索引の1行です。</p>
    <ul class="src rule-list">
      <li>
        <strong>リンク</strong>
        <ul>
          <li>タイトルのリンクを行全体へ広げる</li>
          <li>タグリンクだけ前面へ出す</li>
        </ul>
      </li>
      <li>
        <strong>Hover</strong>
        <ul>
          <li>タイトルへ下線を引く</li>
          <li>矢印を進める</li>
        </ul>
      </li>
    </ul>
    <div class="demo post-card-wrap"><PostListItem post={specimenPost} /></div>
    <p class="source-row"><strong>Source</strong><code>src/components/PostListItem.astro</code><code>src/components/TagList.astro</code></p>
  </div>

  <div class="spec-item" id="kuri">
    <h3>6-5. Kuri</h3>
    <p class="src">栗のマスコットです。</p>
    <ul class="src rule-list">
      <li>
        <strong>配置</strong>
        <ul>
          <li>罫線を地面に見立てて立たせる</li>
        </ul>
      </li>
      <li>
        <strong>描画</strong>
        <ul>
          <li><code>public/images/kuri.svg</code>のパスをそのまま使う</li>
          <li>ライトは塗り、ダークは線画で描く</li>
        </ul>
      </li>
      <li>
        <strong>アクション</strong>
        <ul>
          <li>視線がポインターを追う</li>
          <li>まばたきする</li>
          <li>クリックで跳ねる</li>
          <li>prefers-reduced-motion: reduceでは、移動を伴う動きを省く。まばたきの切り替えは残す</li>
        </ul>
      </li>
    </ul>
    <div class="demo kuri-specimen">
      <figure><Kuri size="6rem" /><figcaption>sleepy</figcaption></figure>
      <figure><Kuri size="6rem" mood="asleep" /><figcaption>asleep</figcaption></figure>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/Kuri.astro</code></p>
  </div>

  <div class="spec-item" id="table-of-contents">
    <h3>6-3. Table of Contents</h3>
    <ul class="src rule-list">
      <li>
        <strong>Wide</strong>
        <ul>
          <li>13〜16列に置き、画面内に追従させる。内部でスクロールでき、常時表示する</li>
        </ul>
      </li>
      <li>
        <strong>CompactとMedium</strong>
        <ul>
          <li>記事ヘッダーの直後に置く</li>
          <li>Radix Collapsibleで開閉する</li>
          <li>項目を選ぶと閉じる</li>
        </ul>
      </li>
    </ul>
    <div class="demo toc-specimen">
      <TableOfContents headings={tocHeadings} variant="responsive" client:load />
      <div class="toc-specimen-summary"><strong>Wide</strong><span>画面内に追従・内部スクロール・常時表示</span><strong>CompactとMedium</strong><span>記事ヘッダー直後・折りたたみ・aria-expanded</span></div>
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/toc/TableOfContents.tsx</code><code>src/components/toc/MobileTOC.tsx</code></p>
  </div>

  <div class="spec-item" id="scrapbox-card-list">
    <h3>6-4. Scrapbox Card List</h3>
    <p class="src">Cosenseのメモを、タイトル・説明・更新日の一覧として縦に並べます。</p>
    <ul class="src rule-list">
      <li>
        <strong>リンク</strong>
        <ul>
          <li>各項目は外部リンクで開く</li>
        </ul>
      </li>
      <li>
        <strong>0件のとき</strong>
        <ul>
          <li>非表示のdata-notes-empty要素を出力する。親のレイアウトはこの要素を検出して、空のNotes領域を畳む</li>
        </ul>
      </li>
    </ul>
    <div class="demo scrapbox-specimen">
      <ScrapboxCardList project="specimen" pages={scrapboxPages} client:visible />
    </div>
    <p class="source-row"><strong>Source</strong><code>src/components/scrapbox/ScrapboxCardList.tsx</code></p>
  </div>

</section>
