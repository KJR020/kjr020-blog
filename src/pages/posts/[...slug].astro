---
import { getCollection, render } from "astro:content";
import ImageLightbox from "@/components/article/ImageLightbox.astro";
import { Comments } from "@/components/Comments";
import PostMeta from "@/components/PostMeta.astro";
import type { HeadingItem } from "@/components/toc";
import { hasTableOfContents, TableOfContents } from "@/components/toc";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { createPublishedPostStaticPaths } from "@/lib/postRoutes";
import "@/styles/article-code.css";
import "@/styles/article-content.css";
import "@/styles/article-footnotes.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const fixturePostIds = process.env.TEST_FIXTURES === "true" ? ["__test/article"] : [];
  return createPublishedPostStaticPaths(posts, fixturePostIds);
}

const { post } = Astro.props;
const { Content, headings: rawHeadings } = await render(post);

// h2, h3のみを抽出して型変換
const headings: HeadingItem[] = rawHeadings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({
    id: h.slug,
    text: h.text,
    level: h.depth as 2 | 3,
  }));
const showsTableOfContents = hasTableOfContents(headings);

// Giscus configuration from environment variables
const giscusRepo = import.meta.env.PUBLIC_GISCUS_REPO as `${string}/${string}`;
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const giscusCategory = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
---

<BaseLayout
  title={`${post.data.title} - KJR020's Blog`}
  description={post.data.description}
  image={`/og/posts/${post.id}.png`}
  ogType="article"
  articleHeadline={post.data.title}
  articlePublishedTime={post.data.date}
  articleTags={post.data.tags}
>
  <div class="post-page container mx-auto px-4 py-phi-2xl max-w-6xl">
    <article class="min-w-0" data-pagefind-body>
      <header class="post-article-header mb-phi-2xl">
        <div class="post-header-content min-w-0">
          <h1 class="post-title font-bold font-heading tracking-tight mb-phi-md">{post.data.title}</h1>
          <PostMeta date={post.data.date} tags={post.data.tags} />
        </div>
        <div class="post-header-mascot" aria-hidden="true"></div>
      </header>

      {showsTableOfContents && (
        <div class="post-mobile-toc mb-phi-2xl lg:hidden">
          <TableOfContents headings={headings} variant="mobile" client:load />
        </div>
      )}

      <div
        class:list={[
          "post-reading-layout",
          showsTableOfContents && "post-reading-layout--with-toc",
        ]}
      >
        {/* 記事本文 */}
        <div class="post-reading-main min-w-0">
          <div class="prose prose-neutral dark:prose-invert max-w-none article-reading-content">
            <Content />
          </div>

          <ImageLightbox />

          <Comments
            repo={giscusRepo}
            repoId={giscusRepoId}
            category={giscusCategory}
            categoryId={giscusCategoryId}
            client:only="react"
          />
        </div>

        {/* デスクトップ用目次（右側サイドバー） */}
        {showsTableOfContents && (
          <aside class="post-desktop-toc hidden lg:block">
            <TableOfContents
              headings={headings}
              variant="desktop"
              avatarSrc="/images/kuri_photo.png"
              avatarAlt="KJR020"
              client:load
            />
          </aside>
        )}
      </div>
    </article>
  </div>
</BaseLayout>

<script>
  import { enhanceArticleCodeBlocks } from "@/lib/articleCode";
  import { enhanceFootnotes } from "@/lib/footnotes";

  function initializePostContent() {
    const article = document.querySelector(".article-reading-content");
    if (article) enhanceArticleCodeBlocks(article);
    enhanceFootnotes();
  }

  // DOMContentLoadedで確実に実行
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePostContent);
  } else {
    initializePostContent();
  }
  // View Transitions対応
  document.addEventListener('astro:page-load', initializePostContent);
</script>

<style is:global>
  .post-title {
    font-size: var(--font-size-title1);
    line-height: var(--lh-tight);
  }

  .prose {
    --tw-prose-body: var(--foreground);
    --tw-prose-headings: var(--foreground);
    --tw-prose-links: var(--link);
    --tw-prose-bold: var(--foreground);
    --tw-prose-code: var(--foreground);
  }

  .prose h2 {
    margin-top: var(--phi-3);
    margin-bottom: var(--phi-1);
    font-size: var(--font-size-title2); /* φ = 1.618rem */
    line-height: var(--lh-tight); /* √φ = 1.272 */
    font-weight: 700;
    font-family: var(--font-heading);
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.618rem; /* 1/φ */
  }

  .prose h3 {
    margin-top: var(--phi-2);
    margin-bottom: var(--phi-neg1);
    font-size: var(--font-size-title3); /* √φ = 1.272rem */
    line-height: var(--lh-tight); /* √φ = 1.272 */
    font-weight: 500;
    font-family: var(--font-heading);
    letter-spacing: -0.005em;
  }

  .prose p {
    margin-top: var(--spacing-phi-lg);
    margin-bottom: var(--spacing-phi-lg);
  }

  .prose ul,
  .prose ol {
    margin-top: var(--spacing-phi-lg);
    margin-bottom: var(--spacing-phi-lg);
    padding-left: 1.618rem; /* φ */
  }

  /* リストマーカースタイル */
  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  /* ネストリストの階層別マーカー */
  .prose ul ul {
    list-style-type: circle;
  }

  .prose ul ul ul {
    list-style-type: square;
  }

  .prose li {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  /* インラインコード */
  .prose :not(pre) > code {
    background-color: var(--muted);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: var(--font-mono);
  }

  .prose a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 150ms;
  }

  .prose a:hover {
    color: var(--link-hover);
  }

  .prose img {
    max-width: 100%;
    height: auto;
    width: auto;
  }

  .prose blockquote {
    border-left: 4px solid var(--border);
    padding-left: 1rem;
    margin-top: 1rem;
    margin-bottom: 1rem;
    font-style: italic;
    color: var(--muted-foreground);
  }

  /* 表スタイル */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
    margin-bottom: 1rem;
    display: block;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 0.382rem 0.618rem; /* φ⁻² × φ⁻¹ */
    text-align: left;
  }

  .prose th {
    background-color: var(--muted);
    font-weight: 600;
  }

  .prose tbody tr:nth-child(even) {
    background-color: color-mix(in srgb, var(--muted) 50%, transparent);
  }

  /* 記事ヘッダーのマスコットはWideでだけ表示する */
  .post-header-mascot {
    display: none;
  }

  @media (min-width: 64rem) {
    /* ヘッダーもページと同じ16列。タイトル12列、マスコット4列 */
    .post-article-header {
      display: grid;
      grid-template-columns: repeat(16, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .post-header-content {
      grid-column: 1 / span 12;
    }

    /*
     * マスコットは記事によらず同じ大きさにする。上端をタイトルの上端へ
     * 揃えるため上揃えにし、タイトルが短いときの余りはメタ情報の下へ回す。
     */
    .post-header-mascot {
      display: block;
      grid-column: 14 / span 3;
      align-self: start;
      block-size: var(--phi-4);
      background-image: url("/images/kuri.svg");
      /* 左端を14列目の線へ合わせる */
      background-position: left bottom;
      background-repeat: no-repeat;
      background-size: contain;
      /* 他ページのウォーターマークと同じ強さにする。本文と注意を奪い合わせない */
      opacity: 0.15;
    }

    .dark .post-header-mascot {
      background-image: url("/images/kuri-dark.svg");
    }

    /* 16列グリッド。本文12列、目次4列、gutter 16px */
    .post-reading-layout--with-toc {
      display: grid;
      grid-template-columns: repeat(16, minmax(0, 1fr));
      column-gap: 1rem;
    }

    .post-reading-layout--with-toc > .post-reading-main {
      grid-column: 1 / span 12;
    }

    .post-reading-layout--with-toc > .post-desktop-toc {
      grid-column: 13 / span 4;
    }

  }

  main:has(.post-page) > .kuri-watermark {
    display: none;
  }
</style>
