---
import PostMeta from "@/components/PostMeta.astro";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";

interface Props {
  post: {
    id: string;
    data: {
      title: string;
      date: Date;
      tags?: string[];
    };
  };
}

const { post } = Astro.props;
---

<Card className="post-card relative transition-[background-color,border-color] duration-200 hover:bg-accent/50 hover:border-foreground/15 py-phi-md gap-phi-2xs group">
  <a
    href={`/posts/${post.id}`}
    class="absolute inset-0 z-0"
    aria-label={post.data.title}
  />
  <CardHeader className="py-0 gap-0">
    <CardTitle className="post-card-title text-base leading-normal text-pretty group-hover:text-link transition-colors duration-200">
      {post.data.title}
    </CardTitle>
  </CardHeader>
  <CardContent className="py-0">
    <PostMeta date={post.data.date} tags={post.data.tags} />
  </CardContent>
</Card>

<style>
  :global(.post-card:has(.post-tag-link:hover)) {
    border-color: var(--border);
    background: var(--card);
  }

  :global(.post-card:has(.post-tag-link:hover) .post-card-title) {
    color: var(--card-foreground);
  }
</style>
