---
import GuidelinesCatalog from "../components/catalog/GuidelinesCatalog.astro";
import DesignSystemLayout from "../components/DesignSystemLayout.astro";
---

<DesignSystemLayout
  activePage="governance"
  title="ガバナンス - KJR020's Blog デザインシステム"
  description="KJR020's Blogのデザイン仕様と実装を一致させて保つための管理・更新ルール"
>
  <header class="book-intro" id="overview">
    <h1 class="book-title">ガバナンス</h1>
    <p class="book-lead">原則、仕様、トークン、部品を管理する場所と、変更時の確認手順を示します。要件はデザイン仕様書で確認します。値と構造は、それぞれの正本で変更します。確認用カタログでは、変更後の表示と操作を確認します。</p>
  </header>

  <GuidelinesCatalog sections={["governance"]} />
</DesignSystemLayout>
