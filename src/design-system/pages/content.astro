---
import GuidelinesCatalog from "../components/catalog/GuidelinesCatalog.astro";
import DesignSystemLayout from "../components/DesignSystemLayout.astro";
---

<DesignSystemLayout
  activePage="content"
  title="コンテンツ - KJR020's Blog デザインシステム"
  description="KJR020's Blogのナビゲーション、操作、状態を分かりやすく伝えるUIライティング仕様"
>
  <header class="book-intro" id="overview">
    <h1 class="book-title">コンテンツ</h1>
    <p class="book-lead">ナビゲーション、操作、状態で使うUI文言の書き方を確認できます。文言は、現在地、起きたこと、次の操作を具体的に伝えます。表示する文言とAccessible nameを一緒に決めます。</p>
  </header>

  <GuidelinesCatalog sections={["writing"]} />
</DesignSystemLayout>
