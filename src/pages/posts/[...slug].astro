---
import { getCollection, render } from "astro:content";
import ImageLightbox from "@/components/article/ImageLightbox.astro";
import { Comments } from "@/components/Comments";
import TagList from "@/components/TagList.astro";
import type { HeadingItem } from "@/components/toc";
import { hasTableOfContents, TableOfContents } from "@/components/toc";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatPostDate } from "@/lib/postDate";
import { assertPostsRendered, createPublishedPostStaticPaths } from "@/lib/postRoutes";
import { isPublishedPost, sortPostsByNewest } from "@/lib/posts";
import { HOME_DESCRIPTION_LINES, SITE_NAME } from "@/lib/siteCopy";
import "@/styles/article-code.css";
import "@/styles/article-content.css";
import "@/styles/article-footnotes.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const fixturePostIds = process.env.TEST_FIXTURES === "true" ? ["__test/article"] : [];
  const paths = createPublishedPostStaticPaths(posts, fixturePostIds);
  assertPostsRendered(paths.map(({ props }) => props.post));
  return paths;
}

const { post } = Astro.props;
const { Content, headings: rawHeadings } = await render(post);

// 目次に載せるのはh2とh3だけにする
const headings: HeadingItem[] = rawHeadings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({
    id: h.slug,
    text: h.text,
    level: h.depth as 2 | 3,
  }));
const showsTableOfContents = hasTableOfContents(headings);

const formattedDate = formatPostDate(post.data.date);

// 前後の記事。公開日の新しい順に並べたときの隣を使う。
// 下書きのプレビューでも位置を決められるよう、表示中の記事は常に含める
const publishedPosts = sortPostsByNewest(
  await getCollection("posts", (entry) => isPublishedPost(entry) || entry.id === post.id),
);
const currentIndex = publishedPosts.findIndex((entry) => entry.id === post.id);
const newerPost = currentIndex > 0 ? publishedPosts[currentIndex - 1] : undefined;
const olderPost = currentIndex >= 0 ? publishedPosts[currentIndex + 1] : undefined;
const adjacentPosts = [
  olderPost && { label: "前の記事", post: olderPost, direction: "older" as const },
  newerPost && { label: "次の記事", post: newerPost, direction: "newer" as const },
].filter((item) => item !== undefined);

// Giscusの接続先は公開してよい設定値なので、ビルド時の環境変数から埋め込む
const giscusRepo = import.meta.env.PUBLIC_GISCUS_REPO as `${string}/${string}`;
const giscusRepoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const giscusCategory = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const giscusCategoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
---

<BaseLayout
  title={`${post.data.title} - ${SITE_NAME}`}
  description={post.data.description}
  image={`/og/posts/${post.id}.png`}
  ogType="article"
  articleHeadline={post.data.title}
  articlePublishedTime={post.data.date}
  articleTags={post.data.tags}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <div class="post-page shell">
    <article class="min-w-0" data-pagefind-body>
      <header class="post-article-header grid-16">
        <div class="post-header-content min-w-0">
          <p class="post-header-meta type-meta">
            <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
          </p>
          <h1
            class="post-title type-heading"
          >
            {post.data.title}
          </h1>
          {post.data.description && <p class="post-lead">{post.data.description}</p>}
          <TagList tags={post.data.tags ?? []} size="md" />
        </div>
      </header>

      {showsTableOfContents && (
        <div class="post-mobile-toc lg:hidden">
          <TableOfContents headings={headings} variant="mobile" client:load />
        </div>
      )}

      <div
        class:list={[
          "post-reading-layout",
          showsTableOfContents && "post-reading-layout--with-toc",
        ]}
      >
        {/* 記事本文 */}
        <div class="post-reading-main min-w-0">
          <div class="prose prose-neutral dark:prose-invert max-w-none article-reading-content">
            <Content />
          </div>

          <ImageLightbox />
        </div>

        {/* デスクトップ用目次（右側サイドバー） */}
        {showsTableOfContents && (
          <aside class="post-desktop-toc hidden lg:block">
            <TableOfContents
              headings={headings}
              variant="desktop"
              avatarSrc="/images/kuri_photo.png"
              avatarAlt=""
              client:load
            />
          </aside>
        )}
      </div>
    </article>

    <footer class="post-end grid-16" data-pagefind-ignore>
      <div class="post-end__main">
        <section class="post-author" aria-labelledby="post-author-title">
          <img src="/images/kuri_photo.png" alt="" width="500" height="500" class="post-author__photo" />
          <div>
            <h2 id="post-author-title" class="post-author__name">KJR020</h2>
            <p class="post-author__bio">{HOME_DESCRIPTION_LINES.join("")}</p>
          </div>
        </section>

        {adjacentPosts.length > 0 && (
          <nav class="post-pager" aria-label="前後の記事">
            {adjacentPosts.map((item) => (
              <a
                href={`/posts/${item.post.id}`}
                class:list={["post-pager__link", `post-pager__link--${item.direction}`]}
                rel={item.direction === "older" ? "prev" : "next"}
              >
                <span class="post-pager__label type-meta">{item.label}</span>
                <span class="post-pager__title type-heading">{item.post.data.title}</span>
              </a>
            ))}
          </nav>
        )}

        <Comments
          repo={giscusRepo}
          repoId={giscusRepoId}
          category={giscusCategory}
          categoryId={giscusCategoryId}
          client:only="react"
        />
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  import { enhanceArticleCodeBlocks } from "@/lib/articleCode";
  import { enhanceFootnotes } from "@/lib/footnotes";

  function initializePostContent() {
    const article = document.querySelector(".article-reading-content");
    if (article) enhanceArticleCodeBlocks(article);
    enhanceFootnotes();
  }

  // DOMContentLoadedで確実に実行
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializePostContent);
  } else {
    initializePostContent();
  }
  // View Transitions対応
  document.addEventListener("astro:page-load", initializePostContent);
</script>

<style is:global>
  /* ---------- Reading progress ---------- */
  .reading-progress {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .reading-progress {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 60;
        display: block;
        block-size: 2px;
        background: var(--brand);
        transform-origin: 0 50%;
        animation: reading-progress linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  @keyframes reading-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ---------- Article header ---------- */
  .post-page {
    padding-block-start: clamp(2.618rem, 1.5rem + 4vw, 4.236rem);
  }

  .post-article-header {
    padding-block-end: var(--phi-2);
    margin-block-end: var(--phi-2);
    border-block-end: 1px solid var(--foreground);
  }

  .post-header-content {
    display: grid;
    gap: var(--phi-1);
  }

  @media (min-width: 64rem) {
    .post-header-content {
      grid-column: 1 / span 12;
    }
  }

  .post-header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--phi-neg1);
    margin: 0;
  }

  .post-header-meta > :not(:first-child)::before {
    margin-inline-end: var(--phi-neg1);
    color: var(--border-strong);
    content: "/";
  }

  .post-title {
    margin: 0;
    font-size: var(--text-article-title);
    line-height: var(--lh-tight);
  }

  .post-lead {
    max-inline-size: 40rem;
    margin: 0;
    color: var(--foreground-soft);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.9;
  }

  .post-mobile-toc {
    margin-block-end: var(--phi-2);
  }

  /* ---------- Prose ---------- */
  .prose {
    --tw-prose-body: var(--foreground);
    --tw-prose-headings: var(--foreground);
    --tw-prose-links: var(--link);
    --tw-prose-bold: var(--foreground);
    --tw-prose-code: var(--foreground);
  }

  .article-reading-content {
    counter-reset: article-section;
  }

  .prose h2 {
    margin-top: var(--phi-3);
    margin-bottom: var(--phi-1);
    font-size: var(--font-size-title2); /* φ = 1.618rem */
    line-height: var(--lh-tight); /* √φ = 1.272 */
    font-weight: 700;
    font-family: var(--font-heading);
    font-feature-settings: "palt";
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  /* 本文の大見出しに通し番号を振る。脚注の見出しは対象外 */
  .article-reading-content > h2 {
    counter-increment: article-section;
    padding-block-start: var(--phi-1);
    border-block-start: 1px solid var(--border);
  }

  .article-reading-content > h2::before {
    display: block;
    margin-block-end: var(--phi-neg2);
    color: var(--brand);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    content: counter(article-section, decimal-leading-zero);
  }

  .prose h3 {
    margin-top: var(--phi-2);
    margin-bottom: var(--phi-neg1);
    font-size: var(--font-size-title3); /* √φ = 1.272rem */
    line-height: var(--lh-tight); /* √φ = 1.272 */
    font-weight: 700;
    font-family: var(--font-heading);
    font-feature-settings: "palt";
    letter-spacing: 0.01em;
  }

  .prose h4 {
    margin-top: var(--phi-1);
    margin-bottom: var(--phi-neg2);
    font-size: 1.0625rem;
    font-weight: 700;
  }

  /* 見出しと直後の内容を、段落どうしより近づけて1つのまとまりに見せる */
  .prose.article-reading-content :is(h2, h3) + :is(p, ul, ol) {
    margin-top: 0;
  }

  .prose p {
    margin-top: var(--spacing-phi-lg);
    margin-bottom: var(--spacing-phi-lg);
  }

  .prose ul,
  .prose ol {
    margin-top: var(--spacing-phi-lg);
    margin-bottom: var(--spacing-phi-lg);
    padding-left: 1.618rem; /* φ */
  }

  .prose ul {
    list-style-type: disc;
  }

  .prose ol {
    list-style-type: decimal;
  }

  .prose ul ul {
    list-style-type: circle;
  }

  .prose ul ul ul {
    list-style-type: square;
  }

  .prose li {
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .prose li::marker {
    color: var(--muted-foreground);
  }

  .prose strong {
    font-weight: 700;
    background: linear-gradient(transparent 62%, var(--brand-wash) 62%);
  }

  /* インラインコード */
  .prose :not(pre) > code {
    padding: 0.15em 0.4em;
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    background-color: var(--secondary);
    font-size: 0.85em;
  }

  .prose a {
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--link) 40%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition:
      color var(--duration-fast) var(--ease-out),
      text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .prose a:hover {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    width: auto;
  }

  .prose blockquote {
    margin-top: var(--phi-1);
    margin-bottom: var(--phi-1);
    padding: 0.25rem 0 0.25rem var(--phi-1);
    border-left: 2px solid var(--foreground);
    color: var(--foreground-soft);
    font-style: normal;
  }

  .prose hr {
    margin-block: var(--phi-3);
    border: 0;
    border-top: 1px solid var(--border);
  }

  /* 表スタイル */
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin-top: var(--phi-1);
    margin-bottom: var(--phi-1);
    display: block;
    overflow-x: auto;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .prose th,
  .prose td {
    padding: 0.618rem 1rem 0.618rem 0;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    border-bottom-color: var(--foreground);
    font-weight: 700;
    white-space: nowrap;
  }

  /* ---------- Layout ---------- */
  @media (min-width: 64rem) {
    /* 16列グリッド。本文12列、目次4列 */
    .post-reading-layout--with-toc {
      display: grid;
      grid-template-columns: repeat(16, minmax(0, 1fr));
      column-gap: var(--grid-gutter);
    }

    .post-reading-layout--with-toc > .post-reading-main {
      grid-column: 1 / span 12;
    }

    .post-reading-layout--with-toc > .post-desktop-toc {
      grid-column: 13 / span 4;
    }
  }

  /* ---------- Article end ---------- */
  .post-end {
    margin-block-start: var(--phi-4);
  }

  .post-end__main {
    display: grid;
    gap: var(--phi-2);
    min-inline-size: 0;
  }

  @media (min-width: 64rem) {
    .post-end__main {
      grid-column: 1 / span 12;
    }
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: var(--phi-0);
    padding-block: var(--phi-1);
    border-block: 1px solid var(--foreground);
  }

  .post-author__photo {
    flex: none;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--border);
  }

  .post-author__name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .post-author__bio {
    margin: 0.2rem 0 0;
    color: var(--muted-foreground);
    font-size: var(--font-size-small);
  }

  .post-pager {
    display: grid;
    gap: var(--grid-gutter);
  }

  @media (min-width: 48rem) {
    .post-pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .post-pager__link--newer {
      grid-column: 2;
      text-align: end;
    }
  }

  .post-pager__link {
    display: grid;
    align-content: start;
    gap: var(--phi-neg2);
    padding: var(--phi-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--foreground);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .post-pager__link:hover {
    border-color: var(--foreground);
  }

  .post-pager__label::before {
    content: "← ";
  }

  .post-pager__link--newer .post-pager__label::before {
    content: "";
  }

  .post-pager__link--newer .post-pager__label::after {
    content: " →";
  }

  .post-pager__title {
    font-size: 1.0625rem;
    line-height: var(--lh-snug);
  }

  .post-pager__link:hover .post-pager__title {
    color: var(--link);
  }
</style>
