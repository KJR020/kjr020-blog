---
import Kuri from "@/components/Kuri.astro";

const currentYear = new Date().getFullYear();

const links = [
  { href: "/posts", label: "Posts" },
  { href: "/rss.xml", label: "RSS" },
  { href: "https://scrapbox.io/kjr020/", label: "Cosense", external: true },
  { href: "https://github.com/KJR020", label: "GitHub", external: true },
  { href: "https://x.com/kjr020", label: "X", external: true },
];
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <!-- 上端の罫線を地面に見立て、くりを立たせる -->
    <div class="site-footer__kuri">
      <Kuri size="3.25rem" mood="asleep" entrance="none" />
    </div>
    <div class="site-footer__row">
      <a href="/" class="site-footer__wordmark">KJR020's Blog</a>
      <nav aria-label="フッター">
        <ul class="site-footer__links">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
              >
                {link.label}
                {link.external && (
                  <svg
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    width="10"
                    height="10"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.25"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M8 7h9v9" />
                  </svg>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="site-footer__legal">
      <p>© {currentYear} KJR020</p>
      <p>
        当サイトではGoogle Analyticsを使用しています。詳しくは<a href="/privacy">プライバシーポリシー</a>をご覧ください。
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: calc(var(--section-gap) + 4rem);
    border-block-start: 1px solid var(--foreground);
  }

  .site-footer__inner {
    position: relative;
  }

  /* 足先を上端の罫線へ乗せる */
  .site-footer__kuri {
    position: absolute;
    inset-block-end: calc(100% + 1px);
    inset-inline-end: var(--shell-pad);
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--phi-neg1) var(--phi-1);
    padding-block: var(--phi-1) var(--phi-0);
  }

  .site-footer__wordmark {
    color: var(--foreground);
    font-size: 1.272rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--phi-neg3) var(--phi-0);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    min-block-size: 2rem;
    align-items: center;
    gap: 0.25rem;
    color: var(--foreground-soft);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-footer__links a:hover {
    color: var(--link);
  }

  .site-footer__links svg {
    color: var(--muted-foreground);
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--phi-neg2) var(--phi-1);
    padding-block: var(--phi-0) var(--phi-1);
    border-block-start: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .site-footer__legal p {
    margin: 0;
  }

  .site-footer__legal a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__legal a:hover {
    color: var(--foreground);
  }
</style>
