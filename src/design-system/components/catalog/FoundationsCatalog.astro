---
import Kuri from "@/components/Kuri.astro";
import SourceRow from "../SourceRow.astro";

const colorTokens = [
  { name: "--background", label: "Background / Card", role: "ページと面" },
  { name: "--foreground", label: "Foreground", role: "本文と主要情報" },
  { name: "--primary", label: "Primary", role: "主要操作" },
  { name: "--link", label: "Link", role: "遷移可能な情報" },
  { name: "--secondary", label: "Secondary / Muted", role: "補助操作と弱い面" },
  { name: "--muted-foreground", label: "Muted foreground", role: "補助情報" },
  { name: "--border", label: "Border / Input", role: "領域の境界" },
  { name: "--destructive", label: "Destructive", role: "破壊的な操作とエラー" },
] as const;

const calloutTokens = [
  ["--callout-note", "Note", "追加の背景情報や参照"],
  ["--callout-tip", "Tip", "実装を進めるためのヒント"],
  ["--callout-warning", "Warning", "注意が必要な条件"],
  ["--callout-danger", "Danger", "破壊的・危険な操作"],
] as const;

const typeScale = [
  ["Display", "--font-size-display", "--font-weight-display", "404など単一状態の強調"],
  [
    "Title 1",
    "--font-size-title1",
    "--font-weight-section",
    "固定サイズの見出し。ページタイトルは--text-page-title、記事タイトルは--text-article-titleを使う",
  ],
  ["Title 2", "--font-size-title2", "--font-weight-section", "セクション見出し"],
  ["Title 3", "--font-size-title3", "--font-weight-subsection", "小見出し"],
  ["Body", "--font-size-body", "--font-weight-body", "本文"],
  ["Small", "--font-size-small", "--font-weight-body", "補助テキスト・メタ情報"],
  ["Caption", "--font-size-caption", "--font-weight-body", "短い補足"],
] as const;

const spacingTokens = [
  ["φ⁻³", "--phi-neg3"],
  ["φ⁻²", "--phi-neg2"],
  ["φ⁻¹", "--phi-neg1"],
  ["φ⁰", "--phi-0"],
  ["φ¹", "--phi-1"],
  ["φ²", "--phi-2"],
  ["φ³", "--phi-3"],
  ["φ⁴", "--phi-4"],
] as const;

/** UIの動き。用途の短い順に並べる */
const uiCurves = [
  ["--ease-enter", "--duration-slow", "Enter", "内容の入場。減速して止まる"],
  ["--ease-exit", "--duration-fast", "Exit", "退場。加速して短く消える"],
  ["--ease-move", "--duration-base", "Move", "位置の移動、下線"],
  ["--ease-emphasis", "--duration-hero", "Emphasis", "ヒーローの見出しなど、表現的な入場"],
  ["--ease-in-out", "--duration-base", "In-out", "往復する動き"],
] as const;

/** キャラクターのモーション。重さ・接地・間を表す。アクションの順に並べる */
const characterCurves = [
  [
    "--ease-emerge",
    "--duration-kuri-enter",
    "Emerge",
    "登場。罫線の下から出て、行き過ぎた位置で止まる",
  ],
  [
    "--ease-touchdown",
    "--duration-kuri-enter",
    "Touchdown",
    "登場。行き過ぎた位置から足を罫線へ下ろす",
  ],
  ["--ease-recover", "--duration-kuri-enter", "Recover", "登場。着地でつぶれた形から戻る"],
  ["--ease-anticipate", "--duration-kuri-jump", "Anticipate", "ジャンプ前に沈む"],
  ["--ease-push", "--duration-kuri-jump", "Push", "押し出し。離陸の速度を空中の初速へつなぐ"],
  ["--ease-impact", "--duration-kuri-jump", "Impact", "着地の反動。すぐに止まる"],
  ["--ease-settle", "--duration-kuri-jump", "Settle", "反動から静止へ。呼吸の吸う・吐く"],
  ["--ease-eye-lag", "--duration-kuri-jump", "Eye lag", "ジャンプ中、目が体に遅れて動く"],
  ["--ease-eye-catch-up", "--duration-kuri-jump", "Eye catch-up", "遅れた目が体に追いつく"],
  ["--ease-eye-drop", "--duration-kuri-jump", "Eye drop", "着地の衝撃で目が落ちる"],
  ["--ease-blink-close", "--duration-blink-close", "Blink close", "まぶたは速く閉じる"],
  ["--ease-blink-open", "--duration-blink-open", "Blink open", "まぶたはゆっくり開く"],
  ["--ease-doze", "--duration-kuri-doze", "Doze", "まぶたが重くなり、一度持ち直す"],
  ["--ease-drift-off", "--duration-kuri-doze", "Drift off", "持ち直したまぶたが力尽きて閉じきる"],
  ["--ease-relax", "--duration-kuri-doze", "Relax", "寝入って体の力が抜ける"],
  [
    "--ease-eye-swap",
    "--duration-kuri-eye-swap",
    "Eye swap",
    "開いた目の縁と眠った目の弧を入れ替える",
  ],
  ["--ease-zzz-fade", "--duration-kuri-zzz-fade", "Zzz fade", "起きるとzzzが消える"],
  ["--ease-zzz-float", "--duration-kuri-zzz-float", "Zzz float", "zzzが浮かんで消える"],
] as const;

const uiDurations = [
  ["--duration-quick", "ポインターへの即時反応"],
  ["--duration-fast", "Hover、矢印"],
  ["--duration-base", "下線、部品の状態変化"],
  ["--duration-slow", "内容の入場"],
  ["--duration-hero", "ヒーローの見出し、伸び"],
] as const;

const characterDurations = [
  ["--duration-blink-close", "まばたき: 閉じる"],
  ["--duration-blink-hold", "まばたき: 閉じたまま"],
  ["--duration-blink-open", "まばたき: 開く"],
  ["--duration-kuri-wake", "起きる"],
  ["--duration-kuri-eye-swap", "目の縁と眠った目の弧の入れ替え"],
  ["--duration-kuri-enter", "罫線の下からの登場"],
  ["--duration-kuri-jump", "ジャンプ"],
  ["--duration-kuri-doze", "うとうとして眠る"],
  ["--duration-kuri-zzz-fade", "起きたときにzzzが消える"],
  ["--duration-kuri-zzz-float", "zzzが浮かんで消える1周期"],
  ["--duration-kuri-breathe", "呼吸の1周期"],
] as const;

type FoundationSection = "tokens" | "layout" | "states";

interface Props {
  sections?: readonly FoundationSection[];
}

const { sections = ["tokens", "layout", "states"] } = Astro.props;
const shows = (section: FoundationSection) => sections.includes(section);
---

{shows("tokens") && (
<section class="spec" id="tokens">
  <h2>1. トークン</h2>
  <p class="src">トークンは、ブログ全体の見た目と意味を1か所の変更で更新できるようにするために置く。値には数値ではなく用途を表す名前を付け、ページと部品はその名前で値を参照する。</p>

  <div class="spec-item" id="color">
    <h3>1-1. 色の役割</h3>
    <p class="src">色は、情報の役割、操作できるかどうか、状態を伝えるために使う。</p>
    <ul class="src rule-list">
      <li>
        <strong>Token</strong>
        <ul>
          <li>Light / Darkで同じ意味を保つsemantic tokenを選ぶ
            <ul>
              <li>テーマを切り替えても、同じ色が同じ意味を表すようにするため</li>
            </ul>
          </li>
        </ul>
      </li>
      <li>
        <strong>用途</strong>
        <ul>
          <li>面と文字には、ニュートラルを使う</li>
          <li>アクセントは青の1色に限り、リンク、現在地、強調の印に使う
            <ul>
              <li>青がリンクの印として読めるようにするため</li>
            </ul>
          </li>
          <li>赤は、破壊的な操作とエラーに使う</li>
          <li>Calloutの4色は、記事内のCalloutだけに使う</li>
        </ul>
      </li>
      <li>
        <strong>色以外の手がかり</strong>
        <ul>
          <li>色だけを唯一の手がかりにしない
            <ul>
              <li>色を区別しにくい環境でも、意味を判断できるようにするため</li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
    <div class="demo swatches">
      {colorTokens.map((token) => (
        <div class="swatch" data-token={token.name}>
          <div class="swatch-color" style={`--swatch: var(${token.name})`}></div>
          <strong>{token.label}</strong>
          <code data-token-value={token.name}>var({token.name})</code>
          <span>{token.role}</span>
        </div>
      ))}
    </div>
    <SourceRow files={["src/styles/globals.css"]} />
  </div>

  <div class="spec-item" id="callout-colors">
    <h3>1-2. 記事のCallout色</h3>
    <p class="src">Callout色は、本文から補足の種類を識別するためだけに使う。</p>
    <ul class="src rule-list">
      <li>
        <strong>適用する場所</strong>
        <ul>
          <li>左2pxの境界とタイトル文字だけに適用する</li>
          <li>面全体は塗らない
            <ul>
              <li>補足が本文より目立たないようにするため</li>
            </ul>
          </li>
        </ul>
      </li>
      <li>
        <strong>色以外の手がかり</strong>
        <ul>
          <li>色が分からなくても、見出しから意味を判断できるようにする</li>
        </ul>
      </li>
    </ul>
    <div class="demo swatches">
      {calloutTokens.map(([token, label, role]) => (
        <div class="swatch" data-token={token}>
          <div class="swatch-color" style={`--swatch: var(${token})`}></div>
          <strong>{label}</strong>
          <code data-token-value={token}>var({token})</code>
          <span>{role}</span>
        </div>
      ))}
    </div>
    <SourceRow files={["src/styles/globals.css"]} />
  </div>

  <div class="spec-item" id="typography">
    <h3>1-3. 文字階層</h3>
    <p class="src">文字は、書体、サイズ、太さ、行高の組み合わせで情報の階層を伝える。</p>
    <ul class="src rule-list">
      <li>
        <strong>書体</strong>
        <ul>
          <li>本文と見出しには、Noto Sans JPを使う</li>
          <li>Headerのナビゲーションには、system sansを使う</li>
          <li>コードとトークン名には、JetBrains Monoを使う</li>
        </ul>
      </li>
      <li>
        <strong>サイズと行高</strong>
        <ul>
          <li>役割ごとに、黄金比φを基準に定義する</li>
          <li>下の標本は、固定段のトークンを示す</li>
          <li>ページタイトルと記事タイトルには、それぞれ専用の可変サイズを使う
            <ul>
              <li>ページタイトル: <code>--text-page-title</code></li>
              <li>記事タイトル: <code>--text-article-title</code></li>
            </ul>
          </li>
        </ul>
      </li>
      <li>
        <strong>太さ</strong>
        <ul>
          <li>見出しはh4からh1まで、1段上がるごとに100ずつ太くする
            <ul>
              <li>h1は900、h2は800、h3は700とする</li>
              <li>h4とルール見出しは600、本文は400とする</li>
            </ul>
          </li>
          <li>上位の見出しを、下位の見出しやラベルと同じ太さにしない
            <ul>
              <li>同じ太さだと、サイズが大きくても細く見え、階層が読み取れないため</li>
            </ul>
          </li>
          <li>欧文・数字の大見出し(<code>.type-display</code>)は、見出しの階層とは別に800とする</li>
        </ul>
      </li>
    </ul>
    <div class="demo type-list">
      {typeScale.map(([label, token, weight, usage]) => (
        <div class="type-row">
          <div style={`font-size: var(${token}); font-weight: var(${weight})`}>あいうえお Aa 012</div>
          <dl>
            <div><dt>{label}</dt><dd><code>{token}</code></dd></div>
            <div><dt>太さ</dt><dd><code>{weight}</code></dd></div>
            <div><dt>用途</dt><dd>{usage}</dd></div>
          </dl>
        </div>
      ))}
    </div>
    <SourceRow files={["src/styles/globals.css", "src/layouts/BaseHead.astro"]} />
  </div>

  <div class="spec-item" id="spacing">
    <h3>1-4. 黄金比スペーシング</h3>
    <p class="src">余白は、要素どうしの関係と情報の区切りを伝えるために使う。</p>
    <ul class="src rule-list">
      <li>
        <strong>値の選び方</strong>
        <ul>
          <li>黄金比φのscaleから選ぶ</li>
          <li>局所的な数値を追加する前に、既存tokenで関係を表せるか確認する</li>
          <li>φが読みやすさや操作性を損なう場合は、理由と適用範囲を明示して調整する
            <ul>
              <li>φは標準値を選ぶ基準であり、比率の厳守を理由に読みにくさを残さないため</li>
            </ul>
          </li>
        </ul>
      </li>
      <li>
        <strong>広げる順序</strong>
        <ul>
          <li>同一要素内、部品間、セクション間、ページ外周の順に広げる
            <ul>
              <li>余白の広さから、情報の関係の強さを読み取れるようにするため</li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
    <div class="demo spacing-list">
      {spacingTokens.map(([label, token]) => (
        <div class="spacing-row">
          <code>{label}</code>
          <span class="spacing-bar" style={`--space: var(${token})`}></span>
          <code>{token}</code>
          <span data-token-value={token}>var({token})</span>
        </div>
      ))}
    </div>
    <SourceRow files={["src/styles/globals.css"]} />
  </div>

  <div class="spec-item" id="radius">
    <h3>1-5. 角丸・影</h3>
    <p class="src">角丸と影は、面のまとまりと重なりを示すためだけに使う。</p>
    <ul class="src rule-list">
      <li>
        <strong>角丸</strong>
        <ul>
          <li>同じ面に属する情報のまとまりを伝えるために使う
            <ul>
              <li>基準値は0.618remとする</li>
            </ul>
          </li>
          <li>装飾だけを目的に丸めない</li>
        </ul>
      </li>
      <li>
        <strong>影</strong>
        <ul>
          <li>Dialog・Popover・Menuなど、本文の前面に重なる面にだけ使う
            <ul>
              <li>罫線だけでは、本文との重なりを示せないため</li>
            </ul>
          </li>
          <li>面の区切りには使わず、罫線と余白で示す
            <ul>
              <li>枠や影を重ねず、記事の文字を主役にするため</li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
    <div class="demo foundation-pair">
      <div class="radius-grid">
        <div><span class="radius-sample radius-sm"></span><strong>Small</strong><code>--radius-sm</code></div>
        <div><span class="radius-sample radius-md"></span><strong>Medium</strong><code>--radius-md</code></div>
        <div><span class="radius-sample radius-lg"></span><strong>Large</strong><code>--radius-lg</code></div>
        <div><span class="radius-sample radius-full"></span><strong>Full</strong><code>9999px</code></div>
      </div>
      <div class="shadow-specimen">
        <span aria-hidden="true"></span>
        <div><strong>Overlay shadow</strong><code>--shadow-overlay</code><small>Dialog・Popover・Menuなど、本文の前面に浮く面</small></div>
      </div>
    </div>
    <SourceRow files={["src/styles/globals.css", "src/design-system/styles.css"]} />
  </div>

  <div class="spec-item" id="motion">
    <h3>1-6. モーション</h3>
    <p class="src">動きは、状態の変化を伝えるためと、くりの人格を表すために使う。UIの動きは短く規則的にし、表現的な動きはヒーローとくりに限る。読書を邪魔しないためである。</p>
    <ul class="src rule-list">
      <li>
        <strong>トークン</strong>
        <ul>
          <li>UIのカーブとdurationは、<code>globals.css</code>のトークンを正本とする</li>
          <li>くりの値は、<code>Kuri.astro</code>のトークンを正本とする</li>
          <li>くりの動きには、UIのトークンを流用しない
            <ul>
              <li>UIの値を調整したときに、くりのアクションが意図せず変わらないようにするため</li>
            </ul>
          </li>
        </ul>
      </li>
      <li>
        <strong>標本</strong>
        <ul>
          <li>各カーブは現在のトークン値から描画する</li>
          <li>再生すると、同じ値の動きを確認できる</li>
        </ul>
      </li>
    </ul>

    <h4 class="motion-group-heading">UIのモーション</h4>
    <p class="src">状態・階層・遷移を短く規則的に伝え、操作には即応する。</p>

    <h5 class="motion-heading">イージング</h5>
    <div class="demo curve-grid">
      {uiCurves.map(([easing, duration, label, usage]) => (
        <figure class="curve-card" data-easing={easing} data-duration={duration}>
          <svg class="curve-plot" viewBox="-12 -32 124 164" aria-hidden="true">
            <rect class="curve-frame" x="0" y="0" width="100" height="100" />
            <line class="curve-guide" x1="0" y1="100" x2="100" y2="0" />
            <line class="curve-handle" data-handle="1" />
            <line class="curve-handle" data-handle="2" />
            <path class="curve-line" />
          </svg>
          <figcaption>
            <strong>{label}</strong>
            <code>{easing}</code>
            <code class="curve-value"></code>
            <small>{usage}</small>
          </figcaption>
          <div class="curve-track"><span class="curve-dot" aria-hidden="true"></span></div>
          <button type="button" class="curve-play">{label}を再生</button>
        </figure>
      ))}
    </div>

    <h5 class="motion-heading">Duration</h5>
    <div class="demo duration-list">
      {uiDurations.map(([token, usage]) => (
        <div class="duration-row" data-duration={token}>
          <code>{token}</code>
          <span class="duration-bar" aria-hidden="true"></span>
          <span class="duration-value"></span>
          <small>{usage}</small>
        </div>
      ))}
    </div>

    <h4 class="motion-group-heading">キャラクターのモーション</h4>
    <p class="src">くりの人格を、ポーズ、重心、間で表す。体は重く動かず、目だけが素早く動く。</p>

    <h5 class="motion-heading">イージング</h5>
    <div class="demo curve-grid">
      {characterCurves.map(([easing, duration, label, usage]) => (
        <figure class="curve-card" data-easing={easing} data-duration={duration} data-token-owner="kuri">
          <svg class="curve-plot" viewBox="-12 -32 124 164" aria-hidden="true">
            <rect class="curve-frame" x="0" y="0" width="100" height="100" />
            <line class="curve-guide" x1="0" y1="100" x2="100" y2="0" />
            <line class="curve-handle" data-handle="1" />
            <line class="curve-handle" data-handle="2" />
            <path class="curve-line" />
          </svg>
          <figcaption>
            <strong>{label}</strong>
            <code>{easing}</code>
            <code class="curve-value"></code>
            <small>{usage}</small>
          </figcaption>
          <div class="curve-track"><span class="curve-dot" aria-hidden="true"></span></div>
          <button type="button" class="curve-play">{label}を再生</button>
        </figure>
      ))}
    </div>

    <h5 class="motion-heading">Duration</h5>
    <div class="demo duration-list">
      {characterDurations.map(([token, usage]) => (
        <div class="duration-row" data-duration={token} data-token-owner="kuri">
          <code>{token}</code>
          <span class="duration-bar" aria-hidden="true"></span>
          <span class="duration-value"></span>
          <small>{usage}</small>
        </div>
      ))}
    </div>

    <h5 class="motion-heading">アクション</h5>
    <div class="demo kuri-stage">
      <div class="kuri-stage__ground"><Kuri size="7rem" /></div>
      <div class="kuri-stage__controls">
        <button type="button" data-kuri-event="kuri:enter">登場</button>
        <button type="button" data-kuri-event="kuri:jump">ジャンプ</button>
        <button type="button" data-kuri-event="kuri:blink">まばたき</button>
        <button type="button" data-kuri-event="kuri:sleep">眠る</button>
        <button type="button" data-kuri-event="kuri:wake">起きる</button>
      </div>
    </div>
    <SourceRow files={["src/styles/globals.css", "src/components/Kuri.astro"]} />
  </div>
</section>
)}

{shows("layout") && (
<section class="spec" id="layout">
  <h2>2. レイアウト原則</h2>
  <p class="src">
    レイアウトは、読者が主要な情報を見つけ、読み進められるように、ページの骨格をそろえるために定める。ページの幅、列、余白、読み順を決め、画面幅が変わっても情報の優先順位とDOM順を保つ。
  </p>

  <div class="spec-item" id="page-shell">
    <h3>2-1. ページシェル</h3>
    <ul class="src rule-list">
      <li>
        <strong>構成</strong>
        <ul>
          <li>Sticky Header → Main → Footerで構成する</li>
        </ul>
      </li>
      <li>
        <strong>くりの配置</strong>
        <ul>
          <li>ホームと記事一覧では、見出し下の罫線上へ置く</li>
          <li>記事詳細には置かない
            <ul>
              <li>本文と注意を奪い合わないようにするため</li>
            </ul>
          </li>
        </ul>
      </li>
    </ul>
