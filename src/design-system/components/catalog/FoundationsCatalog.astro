<script>
  // カーブとdurationは、現在のトークン値から描画する。値を標本側へ複製しない
  // UIの値は:rootから、くり専用の値はそれを定義している標本のくりから読む
  const styles = {
    ui: getComputedStyle(document.documentElement),
    kuri: (() => {
      const kuri = document.querySelector(".kuri-stage [data-kuri]");
      return kuri ? getComputedStyle(kuri) : undefined;
    })(),
  };
  const read = (element: HTMLElement, name: string) => {
    const style = element.dataset.tokenOwner === "kuri" ? styles.kuri : styles.ui;
    return style?.getPropertyValue(name).trim() ?? "";
  };
  const toMs = (value: string) =>
    value.endsWith("ms") ? Number.parseFloat(value) : Number.parseFloat(value) * 1000;

  for (const card of document.querySelectorAll<HTMLElement>(".curve-card")) {
    const easing = read(card, card.dataset.easing ?? "");
    const duration = toMs(read(card, card.dataset.duration ?? ""));
    const match = /cubic-bezier\(([^)]+)\)/.exec(easing);
    const points = match?.[1].split(",").map(Number);
    const valueLabel = card.querySelector(".curve-value");
    // コンポーネントの<style>は0.45を.45へ縮めて出力するため、数値から表記を揃える
    const label = points ? `cubic-bezier(${points.join(", ")})` : easing;
    if (valueLabel) valueLabel.textContent = `${label} / ${duration}ms`;
    if (points) {
      const [x1, y1, x2, y2] = points;
      const px = (x: number) => x * 100;
      const py = (y: number) => 100 - y * 100;
      card
        .querySelector(".curve-line")
        ?.setAttribute("d", `M0 100C${px(x1)} ${py(y1)} ${px(x2)} ${py(y2)} 100 0`);
      const handles = card.querySelectorAll(".curve-handle");
      const set = (line: Element | undefined, a: number[], b: number[]) => {
        line?.setAttribute("x1", String(a[0]));
        line?.setAttribute("y1", String(a[1]));
        line?.setAttribute("x2", String(b[0]));
        line?.setAttribute("y2", String(b[1]));
      };
      set(handles[0], [0, 100], [px(x1), py(y1)]);
      set(handles[1], [100, 0], [px(x2), py(y2)]);
    }
    card.querySelector(".curve-play")?.addEventListener("click", () => {
      const track = card.querySelector<HTMLElement>(".curve-track");
      const dot = card.querySelector<HTMLElement>(".curve-dot");
      if (!track || !dot) return;
      const distance = track.clientWidth - dot.offsetWidth;
      dot.animate([{ transform: "translateX(0)" }, { transform: `translateX(${distance}px)` }], {
        duration,
        easing,
        fill: "forwards",
      });
    });
  }

  const durations = [...document.querySelectorAll<HTMLElement>(".duration-row")];
  const values = durations.map((row) => toMs(read(row, row.dataset.duration ?? "")));
  const longest = Math.max(...values.filter((value) => value < 3000));
  durations.forEach((row, index) => {
    const value = values[index];
    row.querySelector(".duration-value")!.textContent = value >= 1000 ? `${value / 1000}s` : `${value}ms`;
    row.style.setProperty("--duration-ratio", String(Math.min(1, value / longest)));
  });

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-kuri-event]")) {
    button.addEventListener("click", () => {
      const kuri = button.closest(".kuri-stage")?.querySelector("[data-kuri]");
      kuri?.dispatchEvent(new Event(button.dataset.kuriEvent ?? ""));
    });
  }
</script>
